// TrackJot v2 schema.
//
// Governing rules (AGENTS.md §3a, §6):
//   - TrackJot owns identity. UUID primary keys, generated by us, never
//     derived from a provider ID, ISRC, MBID, or normalized metadata.
//   - External identifiers are mappings, never primary keys.
//   - Entity identity comes ONLY from provider IDs. An `artists` or `albums`
//     row is never created from a name string.
//   - Display strings (`artistDisplay`, `releaseTitle`) are always populated so
//     every capture path renders correctly even when linkage is impossible.
//   - Default visibility is private. Publishing is always an explicit action.

generator client {
  provider      = "prisma-client-js"
  // "native" for local macOS development; the debian target is what the
  // CI-built standalone artifact needs in order to run on the Ubuntu droplet.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations must not run through a transaction-mode pooler. When DigitalOcean's
  // PgBouncer pool is in use, DATABASE_URL is pooled and DIRECT_URL is direct.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Visibility {
  private
  unlisted
  public
}

/// How precisely a note's "experienced at" date is known.
///
/// People remember listening at very different resolutions — "the 14th of
/// August", "sometime that March", "back in 2011" — and storing all three as a
/// timestamp would silently invent a precision the writer never claimed. The
/// date column holds the earliest instant in the stated range; this says how
/// much of it to believe and therefore how to render it.
enum DatePrecision {
  /// A known instant, not just a day. A scrobble reports the second you heard
  /// something; rounding that to "that day" would discard the one thing a
  /// listening history is actually authoritative about.
  time
  day
  month
  year
}

/// Where a listening record came from.
///
/// Deliberately NOT the `Provider` enum. `Provider` answers "who is allowed to
/// establish the identity of a recording", and Last.fm is excluded from it on
/// purpose (see the comment there). This answers a different question — "who
/// told us this was played" — and listening history is a perfectly good answer
/// to that while being no answer at all to the first.
enum ListenSource {
  lastfm
}

/// How precisely a note's place is recorded.
///
/// `area` is the default and is deliberately coarse — a town, a venue, a
/// neighbourhood — because a private journal that quietly builds a precise
/// movement history is a liability, not a feature. `exact` exists only when the
/// writer opts into it.
enum PlacePrecision {
  area
  exact
}

/// Whether a recording is anchored to an external provider or was typed by a
/// user. See AGENTS.md §3a.5: `user` recordings are creator-scoped, stay out of
/// global resolution candidates, and never reach a shared public surface until
/// they acquire a provider identifier or are deliberately promoted.
enum RecordingOrigin {
  provider
  user
}

/// Sources permitted to establish the identity of a recording, artist or album.
///
/// The governing rule: **a trusted provider is one where the identifier is
/// issued by an authority, not chosen by an uploader.**
///
///   - spotify, apple_music, deezer, tidal — IDs issued by the platform, whose
///     catalog is fed by labels and distributors through a verified pipeline.
///   - musicbrainz, discogs — IDs issued by curated, moderated, edit-audited
///     databases.
///
/// Deliberately ABSENT: youtube, soundcloud, bandcamp. On those, identifiers
/// attach to *uploads* — the ID is real, but what it points at is chosen by
/// whoever uploaded it. A channel can be named "Drake - Topic" by anyone, so
/// no display-string heuristic can make them safe; hardening would need an API
/// key, quota, and an allowlist, to gain nothing the sources above don't
/// already provide.
///
/// Also absent: lastfm (listening history, never an authority) and rym (no
/// public API, and its terms forbid scraping). Add a value back only when a
/// concrete need appears — that is a one-line migration.
///
/// This does NOT restrict what users may write about. Anything unfindable can
/// still be entered by hand; it simply stays `origin = user`, scoped to its
/// creator, and unable to be promoted into shared truth by an unverifiable
/// source. Spam is free to exist privately.
enum Provider {
  spotify
  apple_music
  deezer
  tidal
  musicbrainz
  discogs
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  /// The verified subject from the auth provider. Resolved by lazy upsert on
  /// the first authenticated request using ON CONFLICT, so concurrent first
  /// requests create exactly one row. NEVER accepted from client input.
  ///
  /// ONE column, not an auth_identities table, and that is deliberate. Clerk
  /// links a Google sign-in to an existing account on verified-email match, so
  /// a person who uses email one day and Google the next arrives with the SAME
  /// subject either way. The multiplicity a join table would model does not
  /// exist here — it would be modelling a provider we chose not to use.
  ///
  /// It becomes necessary only if the provider stops linking upstream (which is
  /// the SuperTokens free tier's behaviour) or if a migration wants to run two
  /// providers at once. Adding it then is a backfill from this clean unique
  /// column, which is exactly the cheap position to be in.
  authSubject String @unique @map("auth_subject")

  /// Stored lowercased; the application validates and normalizes, which gives
  /// case-insensitive uniqueness without a citext extension. Application route
  /// names must be reserved before public profiles launch.
  username    String? @unique
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")

  /// IANA zone the account reads and writes times in, e.g. "Europe/Berlin".
  ///
  /// Every timestamp is stored as an instant (timestamptz) and this decides
  /// only how one is *rendered* and how a calendar-day filter is bounded. Both
  /// matter: a listen at 11pm on the 8th in New York is the 9th in UTC, so a
  /// filter with UTC bounds silently excluded the very day the reader could see
  /// on screen.
  ///
  /// Null means "never chosen", which falls back to the product default rather
  /// than to UTC — every existing note was written when that default was the
  /// only behaviour, and flipping them to UTC would move their displayed times.
  timeZone String? @map("time_zone")

  /// The Last.fm account this user connected, as Last.fm itself reported it at
  /// the end of its web auth flow — never typed in, so it cannot be someone
  /// else's profile.
  ///
  /// Still a **source setting, not TrackJot authentication** (AGENTS.md,
  /// Last.fm adapter). The distinction survives the addition of the auth flow
  /// and is worth keeping straight: TrackJot authenticates *to* Last.fm in
  /// order to read a feed the user owns. Last.fm never authenticates anyone
  /// *into* TrackJot, and no TrackJot account depends on it.
  lastfmUsername String?   @map("lastfm_username")
  lastfmLinkedAt DateTime? @map("lastfm_linked_at") @db.Timestamptz(6)

  /// A Last.fm session key, obtained through their web auth flow.
  ///
  /// **This is a credential and is treated as one.** It is never selected into
  /// a page, an API response, or an export; it is never logged; and it is only
  /// ever read by the Last.fm client when signing a request. v1's specific sin
  /// was writing provider tokens into a log stream, and this column is the one
  /// place in v2 where that mistake is available to make again.
  ///
  /// It is stored unencrypted, deliberately. The database is droplet-local and
  /// its off-host backups are encrypted; an attacker able to read this table
  /// can almost certainly read the `.env` that would hold any decryption key,
  /// so encrypting here would buy the appearance of protection rather than the
  /// substance. The protections that actually bind are the three above.
  ///
  /// What it grants: reading this user's own listening history even when they
  /// have hidden it from the public API — which is the entire reason the flow
  /// exists. Revoked from Last.fm's settings, or by disconnecting here.
  lastfmSessionKey        String?   @map("lastfm_session_key")
  /// Set when the user waves away the connect prompt, so it is offered once
  /// rather than nagging on every visit.
  lastfmPromptDismissedAt DateTime? @map("lastfm_prompt_dismissed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  notes              Note[]
  listens            Listen[]
  collections        Collection[]
  imports            Import[]
  tags               Tag[]
  authoredRecordings Recording[]  @relation("RecordingCreatedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Music entities
// ---------------------------------------------------------------------------

model Artist {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  sortName String? @map("sort_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds      ArtistExternalId[]
  recordingCredits RecordingArtist[]
  albumCredits     AlbumArtist[]

  @@map("artists")
}

/// Mirrors RecordingExternalId. Artists are created from these, never from a
/// name string: Exportify's `Artist URI(s)` column splits on commas
/// unambiguously because URIs contain no commas, which is what makes entity
/// linkage safe at ingest.
model ArtistExternalId {
  id       String @id @default(uuid()) @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  provider    Provider
  providerId  String   @map("provider_id")
  providerUrl String?  @map("provider_url")

  /// Allowlisted, size-limited subset plus provenance. Never a full provider
  /// response and never raw embed HTML.
  sourceMetadata Json @default("{}") @map("source_metadata")

  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([artistId])
  @@map("artist_external_ids")
}

/// Albums mirror recordings exactly: an ordered set of credited artists in a
/// join table, plus the raw display string. There is deliberately no
/// `primary_artist_id` — a single foreign key silently drops the second artist
/// of a joint release (the real case: $ome $exy $ongs 4 U is credited
/// "PARTYNEXTDOOR & Drake"), which is precisely how an artist page ends up
/// missing an album. One shape, one rule, for both tracks and albums.
model Album {
  id    String @id @default(uuid()) @db.Uuid
  title String

  /// Raw album-artist string exactly as the source gave it. Display only —
  /// never the browse key. Deriving a browse key from a display string is what
  /// makes Last.fm file a two-artist track under one artist.
  artistDisplay String? @map("artist_display")

  releaseDate DateTime? @map("release_date") @db.Date

  /// Cover art is **linked, never rehosted** — we store provider URLs, not
  /// bytes. Rehosting would mean copyright exposure, storage that grows with
  /// the catalog rather than with usage, and a cache to invalidate. The cost is
  /// link rot, which degrades to a missing image rather than a broken page.
  ///
  /// Two sizes because the product needs both: full size on a collection or
  /// track page, and a 64px thumbnail per row in a fifty-track list where
  /// downloading fifty 640px images would be absurd.
  artworkUrl      String? @map("artwork_url")
  artworkThumbUrl String? @map("artwork_thumb_url")

  sourceMetadata Json @default("{}") @map("source_metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  artists     AlbumArtist[]
  externalIds AlbumExternalId[]
  recordings  Recording[]

  @@map("albums")
}

/// The album-level twin of RecordingArtist, for the same three reasons: a real
/// foreign key Postgres can enforce, a paginable reverse lookup for artist
/// pages, and somewhere to put per-credit facts.
///
/// `position` is the source's ordering as captured — never a canonical claim
/// about billing.
model AlbumArtist {
  albumId  String @map("album_id") @db.Uuid
  artistId String @map("artist_id") @db.Uuid

  position   Int
  creditName String? @map("credit_name")

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@unique([albumId, position])
  @@index([artistId])
  @@map("album_artists")
}

model AlbumExternalId {
  id      String @id @default(uuid()) @db.Uuid
  albumId String @map("album_id") @db.Uuid

  provider    Provider
  providerId  String   @map("provider_id")
  providerUrl String?  @map("provider_url")

  sourceMetadata Json @default("{}") @map("source_metadata")

  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([albumId])
  @@map("album_external_ids")
}

/// A specific recorded performance or version, not an abstract composition.
/// Created lazily as users add music; TrackJot never ingests a global
/// catalog. A manually entered recording may exist with no external identifier.
model Recording {
  id    String @id @default(uuid()) @db.Uuid
  title String

  /// The raw artist string exactly as the source gave it. ALWAYS populated,
  /// never parsed into entities. The track-link path supplies no artist IDs, so
  /// this is what renders there.
  artistDisplay String @map("artist_display")

  origin RecordingOrigin @default(provider)

  /// Set when origin = user, so user-authored recordings can be scoped to their
  /// creator and kept out of other users' resolution candidates.
  createdById String? @map("created_by_id") @db.Uuid

  /// Lowercased, punctuation- and "feat."-stripped artist+title plus a duration
  /// bucket. Written on every insert so that future convergence-based promotion
  /// is a query rather than a bulk re-normalization. Nothing reads it yet.
  normalizedKey String @map("normalized_key")

  durationMs Int? @map("duration_ms")

  /// Usually the album's art, denormalized so a track row renders without a
  /// join — and populated directly for a track with no album row at all.
  artworkUrl      String? @map("artwork_url")
  artworkThumbUrl String? @map("artwork_thumb_url")

  albumId      String?   @map("album_id") @db.Uuid
  /// Denormalized album display, always available even without an Album row.
  releaseTitle String?   @map("release_title")
  releaseDate  DateTime? @map("release_date") @db.Date

  /// Permits conservative deduplication later while retaining redirects from
  /// old public IDs. Resolution must never RETURN a row with this set — follow
  /// the redirect. Merge administration is post-core.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  /// Write-once at creation. A user's typed metadata may initialize a new
  /// recording; afterwards another user's input never mutates this shared row —
  /// it becomes a per-note display override instead.
  canonicalMetadata Json @default("{}") @map("canonical_metadata")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  album           Album?                @relation(fields: [albumId], references: [id], onDelete: SetNull)
  createdBy       User?                 @relation("RecordingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mergedInto      Recording?            @relation("RecordingMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      Recording[]           @relation("RecordingMerge")
  artists         RecordingArtist[]
  externalIds     RecordingExternalId[]
  notes           Note[]
  listens         Listen[]
  collectionItems CollectionItem[]

  @@index([normalizedKey])
  @@index([albumId])
  @@index([origin, createdById])
  @@index([mergedIntoId])
  @@map("recordings")
}

/// A table rather than a `uuid[]` column on recordings, because:
///   1. PostgreSQL cannot enforce a foreign key on array elements.
///   2. Artist pages are a paginated reverse lookup, which a btree on
///      artist_id serves natively and array containment serves poorly.
///   3. Per-credit attributes (creditName, later producer/remixer roles) have
///      nowhere to live in an array.
///
/// `position` is the SOURCE'S ORDERING AS CAPTURED — never a canonical claim
/// about billing. Sources disagree about credit order, and that disagreement is
/// exactly why a per-pair row exists.
model RecordingArtist {
  recordingId String @map("recording_id") @db.Uuid
  artistId    String @map("artist_id") @db.Uuid

  position   Int
  /// How this artist was credited on THIS recording, when it differs from the
  /// artist's canonical name.
  creditName String? @map("credit_name")

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([recordingId, artistId])
  @@unique([recordingId, position])
  @@index([artistId])
  @@map("recording_artists")
}

model RecordingExternalId {
  id          String @id @default(uuid()) @db.Uuid
  recordingId String @map("recording_id") @db.Uuid

  provider    Provider
  providerId  String   @map("provider_id")
  providerUrl String?  @map("provider_url")

  /// Present in Exportify CSVs, which makes cross-provider resolution by ISRC
  /// available for free on the bulk import path.
  isrc                   String?
  musicbrainzRecordingId String? @map("musicbrainz_recording_id") @db.Uuid

  /// A ~30 second preview this provider serves for the track, if it serves one.
  ///
  /// Stored rather than fetched per view: a list of fifty notes must not make
  /// fifty provider calls to decide whether a play button should appear.
  previewUrl String? @map("preview_url")

  /// When a preview was last looked for, whether or not one was found.
  ///
  /// Without this, every track that genuinely has no preview would be queried
  /// again on every single render — the expensive case being the common one,
  /// which is exactly backwards. A null here means "never asked".
  previewCheckedAt DateTime? @map("preview_checked_at") @db.Timestamptz(6)

  sourceMetadata Json @default("{}") @map("source_metadata")

  firstSeenAt    DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([recordingId])
  @@index([isrc])
  @@map("recording_external_ids")
}

// ---------------------------------------------------------------------------
// Notes
// ---------------------------------------------------------------------------

model Note {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  /// A note is about EXACTLY ONE of a recording or a collection, enforced by a
  /// database CHECK rather than by convention. §3a called this the honest form
  /// of collection-level journaling and deferred it; making both nullable
  /// without the constraint would have allowed a note attached to nothing.
  recordingId  String? @map("recording_id") @db.Uuid
  collectionId String? @map("collection_id") @db.Uuid

  /// Optional playlist context: "this track, in this collection". Preserves v1's
  /// meaning without using a Spotify playlist ID as an ownership boundary. The
  /// service must verify the item belongs to the note owner AND points at the
  /// same recording.
  ///
  /// onDelete: SetNull is a BACKSTOP, not the mechanism. Imports create new
  /// immutable snapshots, so a re-import never reaches items beneath a note.
  collectionItemId String? @map("collection_item_id") @db.Uuid

  /// Plain text or a deliberately chosen structured editor format. Never HTML
  /// produced from untrusted input; escape on output per the renderer.
  body String

  /// Per-note display overrides, rendered as `override ?? canonical`. These
  /// exist because recordings are SHARED: one user's correction must never
  /// change what another user saved.
  displayTitle  String? @map("display_title")
  displayArtist String? @map("display_artist")

  /// Random, and cleared when the note goes private — so a leaked link is
  /// revoked without destroying the note, and sharing again mints a new one.
  /// The internal UUID is never the share URL.
  shareToken String? @unique @map("share_token")

  visibility  Visibility @default(private)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(6)

  /// Whether this note travels with its collection when the collection is
  /// shared. Defaults to FALSE and is set only by an explicit per-note choice,
  /// so the invariant survives: publishing a collection never publishes the
  /// notes inside it — it publishes the notes you ticked.
  sharedInCollection Boolean @default(false) @map("shared_in_collection")

  /// WHEN the listening happened, as distinct from when the note was written.
  /// A journal entry about a gig in 2011 is dated 2011, not today.
  experiencedAt        DateTime?      @map("experienced_at") @db.Timestamptz(6)
  experiencedPrecision DatePrecision? @map("experienced_precision")

  /// WHERE it happened. Coarse by default; see PlacePrecision.
  placeLabel     String?         @map("place_label")
  placePrecision PlacePrecision? @map("place_precision")
  placeLat       Decimal?        @map("place_lat") @db.Decimal(9, 6)
  placeLon       Decimal?        @map("place_lon") @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Touched by edits to the note's own content — its body, its tags, its date
  /// or its place. Deliberately NOT touched by a visibility change: "edited"
  /// must mean the writing changed, or the timestamp stops meaning anything.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection     Collection?     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recording      Recording?      @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  collectionItem CollectionItem? @relation(fields: [collectionItemId], references: [id], onDelete: SetNull)
  tags           NoteTag[]

  /// Deduplicates a retried save, and nothing else.
  ///
  /// A jot is two writes — create the note, then mark the listen imported — and
  /// they were not atomic, so a failure between them left a note behind and a
  /// retry wrote a second one. The writes are a transaction now, and this key
  /// makes the *whole* operation replay-safe: one submission produces one note
  /// however many times it is retried.
  ///
  /// Deliberately per-submission, not per-listen. Writing a second, different
  /// note about the same song is a thing people do on purpose, and a fresh
  /// editor generates a fresh key, so that still works.
  idempotencyKey String? @map("idempotency_key")

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([recordingId])
  @@index([collectionId])
  @@index([collectionItemId])
  @@index([visibility, publishedAt(sort: Desc)])
  @@map("notes")
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

model Collection {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  name        String
  description String?

  visibility Visibility @default(private)
  shareToken String?    @unique @map("share_token")

  /// The playlist's own image, or the album's cover. Linked, never rehosted.
  artworkUrl      String? @map("artwork_url")
  artworkThumbUrl String? @map("artwork_thumb_url")

  /// Provenance only. A pasted playlist link attaches these fields to a
  /// collection the user is deliberately creating; it NEVER creates a
  /// collection or a collection item on its own (AGENTS.md §4.4).
  sourceProvider   Provider? @map("source_provider")
  sourceId         String?   @map("source_id")
  sourceUrl        String?   @map("source_url")
  sourceSnapshotAt DateTime? @map("source_snapshot_at") @db.Timestamptz(6)

  /// Which import last populated this collection.
  importId String? @map("import_id") @db.Uuid

  /// When the tracklist was last re-read from its source, and how many times.
  /// A collection is no longer frozen at import — see `refreshCollection` — so
  /// these record that history rather than pretending it did not happen.
  refreshedAt  DateTime? @map("refreshed_at") @db.Timestamptz(6)
  refreshCount Int       @default(0) @map("refresh_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner  User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  import Import?          @relation(fields: [importId], references: [id], onDelete: SetNull)
  items  CollectionItem[]
  notes  Note[]

  @@index([ownerId, updatedAt(sort: Desc)])
  @@index([importId])
  @@map("collections")
}

/// Deliberately NOT unique on (collectionId, recordingId): a playlist can
/// intentionally contain the same recording more than once.
///
/// Snapshots are immutable, so items are inserted once per transaction and
/// never reordered in place. An ordinary unique constraint on
/// (collectionId, position) therefore suffices — do not add a DEFERRABLE
/// constraint until a real reorder workflow exists, which is post-core.
model CollectionItem {
  id           String @id @default(uuid()) @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  recordingId  String @map("recording_id") @db.Uuid

  position Int

  /// Which appearance of this recording this is, counting from 0 in position
  /// order. A playlist can hold the same song three times and a note on the
  /// second one means something specific; this is what lets a refresh re-anchor
  /// that note to the second appearance again even if the order changed around
  /// it. Position alone cannot do it, and recording id alone is ambiguous.
  occurrence Int @default(0)

  /// Retains the raw source row, including the unsplit `Artist URI(s)` and
  /// `Album Artist URI(s)` lists, so later structural backfills need no string
  /// parsing.
  sourceMetadata Json @default("{}") @map("source_metadata")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recording  Recording  @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  notes      Note[]

  @@unique([collectionId, position])
  @@index([collectionId, position])
  @@index([collectionId, recordingId, occurrence])
  @@index([recordingId])
  @@map("collection_items")
}

/// One play, as reported by a listening-history source.
///
/// **Listens are kept separate from recordings, and that is the whole point.**
/// A recording is "this song exists"; a listen is "you heard it, at 7:39pm on a
/// Tuesday". Collapsing the second into the first would make the tenth play
/// indistinguishable from the first, and repeated listening is exactly the
/// signal a music journal is trying to catch.
///
/// It is also a **cache with provenance**, not a mirror. The raw strings the
/// source reported are stored verbatim alongside any MusicBrainz ids it
/// supplied, so that if a source later turns out to have mis-identified
/// something, every row it influenced can be found and unwound. Last.fm is not
/// permitted to establish recording identity (AGENTS.md), so what it says is
/// recorded as *what it said*, not as truth.
model Listen {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  source ListenSource

  /// The source's own identity for this play. Last.fm issues no scrobble id, so
  /// this is derived from the play instant plus the track — see
  /// `lib/music/lastfm/client.ts`. Unique per owner, which makes re-syncing the
  /// same window idempotent instead of duplicating a person's history.
  sourceRef String  @map("source_ref")
  sourceUrl String? @map("source_url")

  /// When it was played. The reason this integration exists.
  playedAt DateTime @map("played_at") @db.Timestamptz(6)

  /// Exactly what the source said, unparsed and unmerged. These are display and
  /// provenance data; no entity is ever created from them (AGENTS.md §3a).
  trackName  String  @map("track_name")
  artistName String  @map("artist_name")
  albumName  String? @map("album_name")

  /// MusicBrainz ids when the source supplied them — frequently empty, which is
  /// expected rather than an error. An MBID is issued by an authority and is a
  /// trusted `Provider`; the *association* between this play and that id is
  /// merely asserted by the source, which is why it is stored here as
  /// provenance and not silently promoted.
  recordingMbid String? @map("recording_mbid")
  artistMbid    String? @map("artist_mbid")
  albumMbid     String? @map("album_mbid")

  /// Set once the user pulls this play into their library. Null means seen but
  /// not adopted — the common case, since most of what you hear is not worth a
  /// note.
  recordingId String?   @map("recording_id") @db.Uuid
  importedAt  DateTime? @map("imported_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recording Recording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  /// Re-reading the same window must update rather than duplicate.
  @@unique([ownerId, source, sourceRef])
  @@index([ownerId, playedAt(sort: Desc)])
  @@index([recordingId])
  @@map("listens")
}

model Import {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  provider Provider
  filename String?

  /// SHA-256 of the original bytes. A repeated hash must warn and require an
  /// explicit choice — never silently duplicate and never silently reject.
  contentHash String? @map("content_hash")

  status       ImportStatus @default(pending)
  rowCount     Int?         @map("row_count")
  errorSummary String?      @map("error_summary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, contentHash])
  @@map("imports")
}

// ---------------------------------------------------------------------------
// Instrumentation
// ---------------------------------------------------------------------------

/// Records when a RETURNING visitor is shown a sign-in prompt, and how long it
/// had been since they last signed in.
///
/// Exists to answer one scheduled question (AGENTS.md §4, "Sessions"): is
/// Clerk's non-sliding 7-day session actually biting? Retention measured
/// through a login wall cannot tell "did not care" from "could not be bothered
/// to sign in again", so this measures the wall itself.
///
/// Deliberately pseudonymous. There is no user ID here and there cannot be —
/// the visitor is signed out, so we do not know who they are. `visitorId` is a
/// random first-party browser identifier carrying no personal data. Nothing
/// here is linkable to an account, an email, or a note.
///
/// Unique on (visitorId, occurredOn) so refreshing the sign-in page records
/// one event per browser per day rather than one per keystroke.
/// A sign-in subject whose account was just deleted, so a still-valid session
/// token cannot lazily re-create it. Pruned after a day. See the migration.
model IdentityTombstone {
  authSubject String   @id @map("auth_subject")
  deletedAt   DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@map("identity_tombstones")
}

model AuthLapse {
  id        String @id @default(uuid()) @db.Uuid
  visitorId String @map("visitor_id")

  /// Calendar date of the lapse, for daily deduplication.
  occurredOn DateTime @map("occurred_on") @db.Date

  /// How many days since this browser last had a live session. Around 7 points
  /// at Clerk's maximum lifetime; much less suggests something else is wrong.
  daysSinceLastSignIn Int @map("days_since_last_sign_in")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([visitorId, occurredOn])
  @@index([occurredOn])
  @@map("auth_lapses")
}

// ---------------------------------------------------------------------------
// Tags
// ---------------------------------------------------------------------------

/// Tag names are unique per owner and stored lowercased by the application,
/// which gives case-insensitive uniqueness without a citext extension.
model Tag {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  name    String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}
